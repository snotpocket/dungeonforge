classDiagram
direction TB

%% ============================================================
%% DUNGEONFORGE - COMPLETE UML CLASS DIAGRAM
%% ============================================================


%% ============================================================
%% CORE DOMAIN
%% ============================================================

namespace Core {

    class Entity {
        <<abstract>>
        #name : String
        #hp : int
        #maxHp : int
        #attackPower : int
        #defense : int

        #Entity(name : String, maxHp : int, attackPower : int, defense : int)
        +getName() String
        +getHp() int
        +getMaxHp() int
        +getAttackPower() int
        +getDefense() int
        +isAlive() boolean
        +takeDamage(amount : int) void
        +heal(amount : int) void
        +describe() String*
        +toString() String
    }

    class Player {
        -gold : int
        -xp : int

        +Player(name : String)
        +getGold() int
        +getXp() int
        +addGold(g : int) void
        +addXp(x : int) void
        +carryCapacity() double
        +describe() String
    }

    class Monster {
        -species : String
        -xpReward : int

        +Monster(species : String, baseHp : int, baseAttack : int, xpReward : int)
        +getSpecies() String
        +getXpReward() int
        +describe() String
    }

    class Room {
        -id : String
        -flavor : String
        -monsters : List~Monster~
        -floorItems : List~Item~
        -chest : Chest

        +Room(id : String)
        +getId() String
        +getFlavor() String
        +setFlavor(f : String) void
        +getMonsters() List~Monster~
        +addMonster(m : Monster) void
        +getFloorItems() List~Item~
        +addItem(i : Item) void
        +getChest() Chest
        +setChest(c : Chest) void
        +hasChest() boolean
    }

    class DungeonLevel {
        -depth : int
        -themeName : String
        -rooms : List~Room~

        +DungeonLevel(depth : int, themeName : String)
        +getDepth() int
        +getThemeName() String
        +getRooms() List~Room~
        +addRoom(r : Room) void
    }

    class GameWorld {
        -player : Player
        -levels : List~DungeonLevel~
        -monsterFactory : MonsterFactory
        -themes : ThemeRegistry

        +GameWorld(player : Player)
        -generate() void
        -populateFor(theme : ThemeKit, isFinalRoom : boolean) RoomPopulator
        +getPlayer() Player
        +getLevels() List~DungeonLevel~
        +getMonsterFactory() MonsterFactory
        +getThemes() ThemeRegistry
        +totalMonsters() int
    }
}


%% ============================================================
%% ITEMS
%% ============================================================

namespace Items {

    class Item {
        <<interface>>
        +getName() String
        +getWeight() double
        +getValue() int
        +describe() String
    }

    class Weapon {
        -name : String
        -weight : double
        -value : int
        -damage : int

        +Weapon(name : String, weight : double, value : int, damage : int)
        +getName() String
        +getWeight() double
        +getValue() int
        +getDamage() int
        +describe() String
    }

    class Armor {
        -name : String
        -weight : double
        -value : int
        -defense : int

        +Armor(name : String, weight : double, value : int, defense : int)
        +getName() String
        +getWeight() double
        +getValue() int
        +getDefense() int
        +describe() String
    }

    class Potion {
        -name : String
        -weight : double
        -value : int
        -healAmount : int

        +Potion(name : String, weight : double, value : int, healAmount : int)
        +getName() String
        +getWeight() double
        +getValue() int
        +getHealAmount() int
        +describe() String
    }

    class Treasure {
        -name : String
        -weight : double
        -value : int

        +Treasure(name : String, weight : double, value : int)
        +getName() String
        +getWeight() double
        +getValue() int
    }

    class Chest {
        -name : String
        -contents : List~Item~

        +Chest(name : String)
        +getName() String
        +getContents() List~Item~
        +add(item : Item) void
        +isEmpty() boolean
        +totalValue() int
    }
}


%% ============================================================
%% CONFIGURATION / SINGLETONS
%% ============================================================

namespace Configuration {

    class GameConfig {
        <<Singleton>>
        -instance : GameConfig
        +settings : Map~String,Object~

        -GameConfig()
        +getInstance() GameConfig
        -loadDefaults() void
        -loadFromClasspath(resourceName : String) void
        +readResource(resourceName : String)$ String
        +getInt(key : String) int
        +getDouble(key : String) double
        +getSeed() long
        +resetForTests()$ void
    }

    class RandomSource {
        <<Singleton>>
        -instance : RandomSource
        -rng : Random
        -seed : long

        -RandomSource()
        +getInstance() RandomSource
        +nextInt(bound : int) int
        +between(lo : int, hi : int) int
        +nextDouble() double
        +pick(options : List~T~) T
        +pick(options : T[]) T
        +getSeed() long
        +reseed(newSeed : long) void
        +resetForTests()$ void
    }

    class Json {
        <<utility>>
        -s : String
        -i : int

        -Json(s : String)
        +parseObject(text : String)$ Map~String,Object~
        -ws() void
        -value() Object
        -object() Map~String,Object~
        -array() List~Object~
        -string() String
        -number() Double
    }
}


%% ============================================================
%% SIMPLE FACTORY
%% ============================================================

namespace SimpleFactory {

    class MonsterFactory {
        <<Simple Factory>>
        -blueprints : Map~String,MonsterDef~

        +MonsterFactory()
        -loadFrom(resourceName : String) void
        +register(def : MonsterDef) void
        +create(id : String, depth : int) Monster
        +idsForTheme(name : String) List~String~
        +bossIdFromTheme(name : String) String
        +has(id : String) boolean
        +blueprintCount() int
        -str(o : Object, fallback : String)$ String
        -num(o : Object, fallback : int)$ int
    }

    class MonsterDef {
        -id : String
        -name : String
        -hp : int
        -attack : int
        -xp : int
        -theme : String
        -boss : boolean

        +MonsterDef(id : String, name : String, hp : int, attack : int, xp : int, theme : String)
        +MonsterDef(id : String, name : String, hp : int, attack : int, xp : int, theme : String, boss : boolean)
        +getId() String
        +getName() String
        +getHp() int
        +getAttack() int
        +getXp() int
        +getTheme() String
        +isBoss() boolean
        +toString() String
    }
}


%% ============================================================
%% FACTORY METHOD / ROOM POPULATORS
%% ============================================================

namespace FactoryMethod {

    class RoomPopulator {
        <<abstract>>
        <<Factory Method>>
        #theme : ThemeKit

        #RoomPopulator(theme : ThemeKit)
        +populate(room : Room, depth : int) final void
        #createEncounter(depth : int) List~Monster~*
        #createChest(depth : int) Chest
        +kind() String*
    }

    class StandardRoomPopulator {
        <<Concrete Creator>>

        +StandardRoomPopulator(theme : ThemeKit)
        +kind() String
        #createEncounter(depth : int) List~Monster~
    }

    class TreasureRoomPopulator {
        <<Concrete Creator>>

        +TreasureRoomPopulator(theme : ThemeKit)
        +kind() String
        #createEncounter(depth : int) List~Monster~
        #createChest(depth : int) Chest
    }

    class BossRoomPopulator {
        <<Concrete Creator>>

        +BossRoomPopulator(theme : ThemeKit)
        +kind() String
        #createEncounter(depth : int) List~Monster~
        #createChest(depth : int) Chest
    }
}


%% ============================================================
%% ABSTRACT FACTORY / THEME KITS
%% ============================================================

namespace AbstractFactory {

    class ThemeKit {
        <<interface>>
        <<Abstract Factory>>

        +themeName() String
        +createMonster(depth : int) Monster
        +createBoss(depth : int) Monster
        +createLoot(depth : int) Item
        +createRoomFlavor() String
    }

    class CryptThemeKit {
        <<Concrete Factory>>
        -factory : MonsterFactory
        -FLAVOURS : String[]

        +CryptThemeKit(factory : MonsterFactory)
        +themeName() String
        +createMonster(depth : int) Monster
        +createBoss(depth : int) Monster
        +createLoot(depth : int) Item
        +createRoomFlavor() String
    }

    class ForgeThemeKit {
        <<Concrete Factory>>
        -factory : MonsterFactory
        -FLAVOURS : String[]

        +ForgeThemeKit(factory : MonsterFactory)
        +themeName() String
        +createMonster(depth : int) Monster
        +createBoss(depth : int) Monster
        +createLoot(depth : int) Item
        +createRoomFlavor() String
    }

    class FrostThemeKit {
        <<Concrete Factory>>
        -factory : MonsterFactory
        -FLAVOURS : String[]

        +FrostThemeKit(factory : MonsterFactory)
        +themeName() String
        +createMonster(depth : int) Monster
        +createBoss(depth : int) Monster
        +createLoot(depth : int) Item
        +createRoomFlavor() String
    }

    class WinterfellThemeKit {
        <<Concrete Factory>>
        -factory : MonsterFactory
        -FLAVOURS : String[]

        +WinterfellThemeKit(factory : MonsterFactory)
        +themeName() String
        +createMonster(depth : int) Monster
        +createBoss(depth : int) Monster
        +createLoot(depth : int) Item
        +createRoomFlavor() String
    }

    class ThemeRegistry {
        -kits : List~ThemeKit~

        +ThemeRegistry(factory : MonsterFactory)
        +forDepth(depth : int) ThemeKit
        +size() int
        +themeName() List~String~
    }
}


%% ============================================================
%% APPLICATION ENTRY POINT
%% ============================================================

namespace Application {

    class Main {
        <<utility>>
        +VERSION : String

        -Main()
        +banner()$ String
        +main(args : String[])$ void
    }
}


%% ============================================================
%% INHERITANCE / IMPLEMENTATION
%% ============================================================

Entity <|-- Player
Entity <|-- Monster

Item <|.. Weapon
Item <|.. Armor
Item <|.. Potion
Item <|.. Treasure

RoomPopulator <|-- StandardRoomPopulator
RoomPopulator <|-- TreasureRoomPopulator
RoomPopulator <|-- BossRoomPopulator

ThemeKit <|.. CryptThemeKit
ThemeKit <|.. ForgeThemeKit
ThemeKit <|.. FrostThemeKit
ThemeKit <|.. WinterfellThemeKit


%% ============================================================
%% CORE COMPOSITION / ASSOCIATIONS
%% ============================================================

GameWorld "1" *-- "1" Player : owns
GameWorld "1" *-- "*" DungeonLevel : generates
DungeonLevel "1" *-- "*" Room : contains
Room "1" o-- "*" Monster : contains
Room "1" o-- "*" Item : floor items
Room "1" o-- "0..1" Chest : contains

Chest "1" *-- "*" Item : contains


%% ============================================================
%% SIMPLE FACTORY RELATIONSHIPS
%% ============================================================

MonsterFactory "1" o-- "*" MonsterDef : stores blueprints
MonsterFactory ..> Monster : creates
MonsterFactory ..> MonsterDef : reads
MonsterFactory ..> Json : parses
MonsterFactory ..> GameConfig : reads resources
MonsterFactory ..> RandomSource : uses randomness

note for MonsterFactory "SIMPLE FACTORY\ncreate(id, depth) selects a MonsterDef\nand constructs a Monster."


%% ============================================================
%% FACTORY METHOD RELATIONSHIPS
%% ============================================================

RoomPopulator o-- "1" ThemeKit : uses theme
RoomPopulator ..> Room : populates
RoomPopulator ..> Monster : creates encounter
RoomPopulator ..> Chest : optionally creates

StandardRoomPopulator ..> GameConfig : reads maxMonstersPerRoom
StandardRoomPopulator ..> RandomSource : chooses count

TreasureRoomPopulator ..> RandomSource : chooses loot count

BossRoomPopulator ..> Monster : creates boss encounter

note for RoomPopulator "FACTORY METHOD\npopulate() is the fixed algorithm.\ncreateEncounter() and createChest()\nare overridden by concrete populators."


%% ============================================================
%% ABSTRACT FACTORY RELATIONSHIPS
%% ============================================================

ThemeRegistry "1" *-- "*" ThemeKit : registers
ThemeRegistry o-- CryptThemeKit
ThemeRegistry o-- ForgeThemeKit
ThemeRegistry o-- FrostThemeKit
ThemeRegistry o-- WinterfellThemeKit

CryptThemeKit --> MonsterFactory : delegates monster creation
ForgeThemeKit --> MonsterFactory : delegates monster creation
FrostThemeKit --> MonsterFactory : delegates monster creation
WinterfellThemeKit --> MonsterFactory : delegates monster creation

CryptThemeKit ..> Monster : creates
CryptThemeKit ..> Weapon : creates
CryptThemeKit ..> Armor : creates
CryptThemeKit ..> Potion : creates
CryptThemeKit ..> Treasure : creates

ForgeThemeKit ..> Monster : creates
ForgeThemeKit ..> Weapon : creates
ForgeThemeKit ..> Armor : creates
ForgeThemeKit ..> Potion : creates
ForgeThemeKit ..> Treasure : creates

FrostThemeKit ..> Monster : creates
FrostThemeKit ..> Weapon : creates
FrostThemeKit ..> Armor : creates
FrostThemeKit ..> Potion : creates
FrostThemeKit ..> Treasure : creates

WinterfellThemeKit ..> Monster : creates
WinterfellThemeKit ..> Weapon : creates
WinterfellThemeKit ..> Armor : creates
WinterfellThemeKit ..> Potion : creates
WinterfellThemeKit ..> Treasure : creates

note for ThemeKit "ABSTRACT FACTORY\nCreates a family of related dungeon products:\nMonster + Boss + Loot + Room Flavor."


%% ============================================================
%% GAME WORLD FACTORY COORDINATION
%% ============================================================

GameWorld "1" --> "1" MonsterFactory : owns
GameWorld "1" --> "1" ThemeRegistry : owns
GameWorld ..> ThemeKit : obtains from registry
GameWorld ..> RoomPopulator : selects
GameWorld ..> StandardRoomPopulator : creates
GameWorld ..> TreasureRoomPopulator : creates
GameWorld ..> BossRoomPopulator : creates

GameWorld ..> GameConfig : configuration
GameWorld ..> RandomSource : room selection


%% ============================================================
%% SINGLETON RELATIONSHIPS
%% ============================================================

GameConfig ..> Json : parses config
GameConfig ..> RandomSource : seed source

RandomSource --> GameConfig : gets initial seed
RandomSource ..> Random : wraps

Player ..> GameConfig : reads settings
Monster ..> RandomSource : stat variance

CryptThemeKit ..> RandomSource : random selection
ForgeThemeKit ..> RandomSource : random selection
FrostThemeKit ..> RandomSource : random selection
WinterfellThemeKit ..> RandomSource : random selection


%% ============================================================
%% APPLICATION RELATIONSHIPS
%% ============================================================

Main ..> GameConfig : uses
Main ..> RandomSource : uses / reseeds
Main ..> Player : creates
Main ..> GameWorld : creates
Main ..> DungeonLevel : displays
Main ..> Room : displays
Main ..> Monster : displays