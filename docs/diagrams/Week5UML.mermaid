classDiagram
direction LR

%% =========================================================
%% DUNGEONFORGE — COMPLETE UML / DESIGN PATTERN MAP
%% =========================================================

%% =========================================================
%% SINGLETONS
%% =========================================================

    class GameConfig {
        <<Singleton>>
        -static GameConfig instance
        -Map~String,Object~ settings
        -GameConfig()
        +static GameConfig getInstance() GameConfig
        +static String readResource(String resourceName)
        +int getInt(String key)
        +double getDouble(String key)
        +long getSeed() long
        +static void resetForTests()
    }

    class RandomSource {
        <<Singleton>>
        -static RandomSource instance
        -Random rng
        -long seed
        -RandomSource()
        +static RandomSource getInstance() RandomSource
        +int nextInt(int bound)
        +int between(int lo, int hi)
        +double nextDouble()
        +T pick(List~T~ options)
        +T pick(T[] options)
        +long getSeed()
        +void reseed(long newSeed)
        +static void resetForTests()
    }


%% =========================================================
%% STRATEGY
%% =========================================================
    class CombatStrategy {
        <<interface>>
        +Action chooseAction(Monster self, Player player, Room room)
        +String name()
    }

    class AggressiveStrategy {
        +Action chooseAction(Monster self, Player player, Room room)
        +String name()
    }

    class HealerStrategy {
        +Action chooseAction(Monster self, Player target, Room room)
        +String name()
    }

    class RangedStrategy {
        +Action chooseAction(Monster self, Player target, Room room)
        +String name()
    }

    class SkittishStrategy {
        +Action chooseAction(Monster self, Player target, Room room)
        +String name()
    }

    class Action {
        -Type type
        -Entity target
        -String flavour
        +Action(Type type, Entity target, String flavour)
        +static Action wait(String flavour)
        +Type getType()
        +Entity getTarget()
        +String getFlavour()
    }

    class Action.Type {
        <<enumeration>>
        ATTACK
        RANGED_ATTACK
        FLEE
        HEAL_ALLY
        WAIT
    }


CombatStrategy <|.. AggressiveStrategy
CombatStrategy <|.. HealerStrategy
CombatStrategy <|.. RangedStrategy
CombatStrategy <|.. SkittishStrategy

Action --> Action.Type
Action --> Entity : target

Monster o-- CombatStrategy : strategy

%% =========================================================
%% SIMPLE FACTORY
%% =========================================================
    class MonsterFactory {
        <<Simple Factory>>
        -Map~String,MonsterDef~ blueprints
        +MonsterFactory()
        +void register(MonsterDef def)
        +Monster create(String id, int depth)
        +List~String~ idsForTheme(String name)
        +String bossIdFromTheme(String theme)
        +boolean has(String id)
        +int blueprintCount()
        +static CombatStrategy strategyFor(String name)
    }

    class MonsterDef {
        -String id
        -String name
        -int hp
        -int attack
        -int xp
        -String theme
        -boolean boss
        -String strategy
        +MonsterDef(...)
        +String getId()
        +String getName()
        +int getHp()
        +int getAttack()
        +int getXp()
        +String getTheme()
        +boolean isBoss()
        +String getStrategy()
        +String toString()
    }

MonsterFactory --> MonsterDef : stores blueprints
MonsterFactory ..> Monster : creates
MonsterFactory ..> CombatStrategy : creates strategy
MonsterFactory ..> AggressiveStrategy
MonsterFactory ..> RangedStrategy
MonsterFactory ..> SkittishStrategy
MonsterFactory ..> HealerStrategy
MonsterFactory ..> GameConfig : reads resources
MonsterFactory ..> RandomSource : stat variance

%% =========================================================
%% ABSTRACT FACTORY
%% =========================================================
    class ThemeKit {
        <<interface>>
        +String themeName()
        +Monster createMonster(int depth)
        +Monster createBoss(int depth)
        +Item createLoot(int depth)
        +String createRoomFlavor()
    }

    class CryptThemeKit {
        -MonsterFactory factory
        +CryptThemeKit(MonsterFactory factory)
        +String themeName()
        +Monster createMonster(int depth)
        +Monster createBoss(int depth)
        +Item createLoot(int depth)
        +String createRoomFlavor()
    }

    class ForgeThemeKit {
        -MonsterFactory factory
        +ForgeThemeKit(MonsterFactory factory)
        +String themeName()
        +Monster createMonster(int depth)
        +Monster createBoss(int depth)
        +Item createLoot(int depth)
        +String createRoomFlavor()
    }

    class FrostThemeKit {
        -MonsterFactory factory
        +FrostThemeKit(MonsterFactory factory)
        +String themeName()
        +Monster createMonster(int depth)
        +Monster createBoss(int depth)
        +Item createLoot(int depth)
        +String createRoomFlavor()
    }

    class WinterfellThemeKit {
        -MonsterFactory factory
        +WinterfellThemeKit(MonsterFactory factory)
        +String themeName()
        +Monster createMonster(int depth)
        +Monster createBoss(int depth)
        +Item createLoot(int depth)
        +String createRoomFlavor()
    }

    class ThemeRegistry {
        <<registry>>
        -List~ThemeKit~ kits
        +ThemeRegistry(MonsterFactory factory)
        +ThemeKit forDepth(int depth)
        +int size()
        +List~String~ themeNames()
    }

ThemeKit <|.. CryptThemeKit
ThemeKit <|.. ForgeThemeKit
ThemeKit <|.. FrostThemeKit
ThemeKit <|.. WinterfellThemeKit

CryptThemeKit --> MonsterFactory
ForgeThemeKit --> MonsterFactory
FrostThemeKit --> MonsterFactory
WinterfellThemeKit --> MonsterFactory

CryptThemeKit ..> Monster
CryptThemeKit ..> Item
ForgeThemeKit ..> Monster
ForgeThemeKit ..> Item
FrostThemeKit ..> Monster
FrostThemeKit ..> Item
WinterfellThemeKit ..> Monster
WinterfellThemeKit ..> Item

ThemeRegistry o-- ThemeKit
ThemeRegistry --> MonsterFactory

%% =========================================================
%% FACTORY METHOD
%% =========================================================
    class RoomPopulator {
        <<abstract>>
        #ThemeKit theme
        +RoomPopulator(ThemeKit theme)
        +final void populate(Room room, int depth)
        #abstract List~Monster~ createEncounter(int depth)
        #Chest createChest(int depth)
        +abstract String kind()
    }

    class StandardRoomPopulator {
        +StandardRoomPopulator(ThemeKit theme)
        +String kind()
        #List~Monster~ createEncounter(int depth)
    }

    class TreasureRoomPopulator {
        +TreasureRoomPopulator(ThemeKit theme)
        +String kind()
        #List~Monster~ createEncounter(int depth)
        #Chest createChest(int depth)
    }

    class BossRoomPopulator {
        +BossRoomPopulator(ThemeKit theme)
        +String kind()
        #List~Monster~ createEncounter(int depth)
        #Chest createChest(int depth)
    }

RoomPopulator <|-- StandardRoomPopulator
RoomPopulator <|-- TreasureRoomPopulator
RoomPopulator <|-- BossRoomPopulator

RoomPopulator --> ThemeKit : has-a
RoomPopulator ..> Room : populates
RoomPopulator ..> Monster : creates via ThemeKit
RoomPopulator ..> Chest : creates

StandardRoomPopulator ..> GameConfig
StandardRoomPopulator ..> RandomSource

TreasureRoomPopulator ..> RandomSource
TreasureRoomPopulator ..> Chest

BossRoomPopulator ..> Chest

%% =========================================================
%% OBSERVER
%% =========================================================
    class EventBus {
        <<Subject / Publisher>>
        -List~GameEventListener~ listeners
        +void subscribe(GameEventListener listener)
        +void unsubscribe(GameEventListener listener)
        +void publish(GameEvent event)
        +void message(String text)
        +int listenerCount()
    }

    class GameEventListener {
        <<interface>>
        +void onEvent(GameEvent event)
    }

    class GameEvent {
        -EventType type
        -Map~String,Object~ payload
        +GameEvent(EventType type)
        +static GameEvent of(EventType type, Object... keyValuePairs)
        +EventType getType()
        +Object get(String key)
        +String getString(String key)
        +int getInt(String key)
        +String toString()
        +static GameEvent message(String text)
    }

    class EventType {
        <<enumeration>>
        DAMAGE_DEALT
        DAMAGE_TAKEN
        MONSTER_DIED
        MONSTER_FLED
        MONSTER_HEALED
        STRATEGY_CHANGED
        XP_GAINED
        GOLD_GAINED
        LEVEL_ENTERED
        ROOM_CLEARED
        PLAYER_DIED
        DELVE_SURVIVED
        MESSAGE
    }

    class QuestTracker {
        -List~Quest~ quests
        -EventBus bus
        +QuestTracker(EventBus bus)
        +void onEvent(GameEvent event)
        +List~Quest~ getQuests()
        +int completedCount()
    }

    class AchievementSystem {
        -Set~String~ unlocked
        -EventBus bus
        -int kills
        -int fled
        -int deepestLevel
        +AchievementSystem(EventBus bus)
        +void onEvent(GameEvent event)
        +Set~String~ getUnlocked()
    }

    class CombatLog {
        -Deque~String~ lines
        -int maxLines
        +CombatLog(int maxLines)
        +void onEvent(GameEvent event)
        +Deque~String~ getLines()
        +int size()
    }

    class DangerMeter {
        -EventBus bus
        -Player player
        -int damageThreshold
        +DangerMeter(EventBus bus, Player player, int damageThreshold)
        +void onEvent(GameEvent event)
    }

    class Quest {
        -String id
        -String description
        -EventType trigger
        -int required
        -int progress
        +Quest(...)
        +String getId()
        +String getDescription()
        +EventType getTrigger()
        +int getRequired()
        +int getProgress()
        +boolean isComplete()
        +boolean advance()
        +String toString()
    }

GameEventListener <|.. QuestTracker
GameEventListener <|.. AchievementSystem
GameEventListener <|.. CombatLog
GameEventListener <|.. DangerMeter

EventBus o-- GameEventListener : listeners
EventBus ..> GameEvent : publishes

GameEvent --> EventType
GameEvent o-- "0..*" Object : payload

QuestTracker --> EventBus
QuestTracker o-- Quest
Quest --> EventType

AchievementSystem --> EventBus
CombatLog --> GameEvent
DangerMeter --> EventBus
DangerMeter --> Player

%% =========================================================
%% CORE DOMAIN
%% =========================================================
    class Entity {
        <<abstract>>
        #String name
        #int hp
        #int maxHp
        #int attackPower
        #int defense
        #Entity(String name, int maxHp, int attackPower, int defense)
        +String getName()
        +int getHp()
        +int getMaxHp()
        +int getAttackPower()
        +int getDefense()
        +boolean isAlive()
        +void takeDamage(int amount)
        +void heal(int amount)
        +abstract String describe()
        +String toString()
    }

    class Player {
        -int gold
        -int xp
        +Player(String name)
        +int getGold()
        +int getXp()
        +void addGold(int g)
        +void addXp(int x)
        +double carryCapacity()
        +String describe()
    }

    class Monster {
        -String species
        -int xpReward
        -CombatStrategy strategy
        +Monster(String species, int maxHp, int attackPower, int xpReward)
        +String getSpecies()
        +int getXpReward()
        +CombatStrategy getStrategy()
        +void setStrategy(CombatStrategy strategy)
        +double HpFraction()
        +String describe()
    }

    class Room {
        -String id
        -String flavor
        -List~Monster~ monsters
        -List~Item~ floorItems
        -Chest chest
        +Room(String id)
        +String getId()
        +String getFlavor()
        +void setFlavor(String f)
        +List~Monster~ getMonsters()
        +void addMonster(Monster m)
        +List~Item~ getFloorItems()
        +void addItem(Item i)
        +Chest getChest()
        +void setChest(Chest c)
        +boolean hasChest()
    }

    class DungeonLevel {
        -int depth
        -String themeName
        -List~Room~ rooms
        +DungeonLevel(int depth, String themeName)
        +int getDepth()
        +String getThemeName()
        +List~Room~ getRooms()
        +void addRoom(Room r)
    }

    class GameWorld {
        -Player player
        -MonsterFactory monsterFactory
        -ThemeRegistry themes
        -List~DungeonLevel~ levels
        +GameWorld(Player player)
        -void generate()
        -RoomPopulator populatorFor(ThemeKit theme, boolean isFinalRoom)
        +Player getPlayer()
        +List~DungeonLevel~ getLevels()
        +MonsterFactory getMonsterFactory()
        +ThemeRegistry getThemes()
        +int totalMonsters()
        +int totalLoot()
    }

    class Combat {
        -EventBus bus
        -static int MAX_ROUNDS
        +Combat(EventBus bus)
        +boolean fight(Player player, Room room, int depth)
        -void playerActs(Player player, Room room)
        -void checkForTacticsChange(Monster m)
        -void monsterActs(Monster m, Player player, Room room)
        -boolean hasLiving(Room room)
        -Monster firstLiving(Room room)
        -List~Monster~ livingMonsters(Room room)
        +static void restAfterRoom(Player player)
    }

Entity <|-- Player
Entity <|-- Monster

Player ..> GameConfig
Monster --> CombatStrategy

Room o-- "0..*" Monster
Room o-- "0..*" Item
Room --> Chest

DungeonLevel o-- "1..*" Room
GameWorld --> Player
GameWorld o-- DungeonLevel
GameWorld --> MonsterFactory
GameWorld --> ThemeRegistry
GameWorld --> ThemeKit
GameWorld ..> RoomPopulator
GameWorld ..> RandomSource
GameWorld ..> GameConfig

Combat --> EventBus
Combat --> Player
Combat --> Room
Combat --> Monster
Combat ..> Action
Combat ..> GameConfig
Combat ..> SkittishStrategy

%% =========================================================
%% ITEMS
%% =========================================================
    class Item {
        <<interface>>
        +String getName()
        +double getWeight()
        +int getValue()
        +String describe()
    }

    class Weapon {
        -String name
        -double weight
        -int value
        -int damage
        +Weapon(...)
        +String getName()
        +double getWeight()
        +int getValue()
        +int getDamage()
        +String describe()
    }

    class Armor {
        -String name
        -double weight
        -int value
        -int defense
        +Armor(...)
        +String getName()
        +double getWeight()
        +int getValue()
        +int getDefense()
        +String describe()
    }

    class Potion {
        -String name
        -double weight
        -int value
        -int healAmount
        +Potion(...)
        +String getName()
        +double getWeight()
        +int getValue()
        +int getHealAmount()
        +String describe()
    }

    class Treasure {
        -String name
        -double weight
        -int value
        +Treasure(...)
        +String getName()
        +double getWeight()
        +int getValue()
    }

    class Chest {
        -String name
        -List~Item~ contents
        +Chest(String name)
        +String getName()
        +List~Item~ getContents()
        +void add(Item item)
        +boolean isEmpty()
        +int totalValue()
    }

Item <|.. Weapon
Item <|.. Armor
Item <|.. Potion
Item <|.. Treasure

Chest o-- "0..*" Item
Room --> Chest

%% =========================================================
%% CONFIG / UTILITY
%% =========================================================
    class Json {
        <<utility>>
        -String s
        -int i
        -Json(String s)
        +static Map~String,Object~ parseObject(String text)
    }

GameConfig ..> Json
GameConfig ..> Json : parses config.json
MonsterFactory ..> Json : parses monsters.json

%% =========================================================
%% APPLICATION ENTRY POINT
%% =========================================================
    class Main {
        <<entry point>>
        +static String VERSION
        -Main()
        +static String banner()
        +static void main(String[] args)
        -static void delve(GameWorld world, Player player, EventBus bus)
    }


Main ..> GameConfig
Main ..> RandomSource
Main ..> Player
Main ..> GameWorld
Main ..> EventBus
Main ..> QuestTracker
Main ..> AchievementSystem
Main ..> CombatLog
Main ..> DangerMeter
Main ..> Combat
Main ..> DungeonLevel
Main ..> Room
Main ..> Monster
