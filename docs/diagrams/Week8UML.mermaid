---
title: DungeonForge — OOP & Design Patterns UML
---
classDiagram
direction TB

%% ============================================================
%% PATTERN 1 — STRATEGY
%% Contract: CombatStrategy; interchangeable algorithms.
%% Monster HAS-A strategy; Combat asks it for an Action.
%% ============================================================
class CombatStrategy {
  <<interface>>
  +chooseAction(Monster, Player, Room) Action
  +name() String
}
class AggressiveStrategy {
  +chooseAction(Monster, Player, Room) Action
  +name() String
}
class HealerStrategy {
  +chooseAction(Monster, Player, Room) Action
  +name() String
}
class RangedStrategy {
  +chooseAction(Monster, Player, Room) Action
  +name() String
}
class SkittishStrategy {
  +chooseAction(Monster, Player, Room) Action
  +name() String
}
class Action {
  <<decision value object>>
  +Type type
  +Entity target
  +String flavor
  +wait(String) Action
}
class Combat {
  +monsterTurns(Player, Room) void
  -monsterActs(Monster, Player, Room) void
  +playerStrikes(Player, Monster) void
}
CombatStrategy <|.. AggressiveStrategy : implements
CombatStrategy <|.. HealerStrategy : implements
CombatStrategy <|.. RangedStrategy : implements
CombatStrategy <|.. SkittishStrategy : implements
Monster --> "0..1" CombatStrategy : strategy / swappable
CombatStrategy ..> Action : returns decision
Combat ..> CombatStrategy : invokes
Combat ..> Action : executes returned action

%% ============================================================
%% PATTERN 2 — STATE
%% MonsterState represents lifecycle behavior; concrete states
%% decide whether a monster acts, damage multiplier and next state.
%% GameState separately models the player's command/UI mode.
%% ============================================================
class MonsterState {
  <<interface>>
  +onEnter(Monster) void
  +canAct() boolean
  +damageMultiplier() double
  +next(Monster, Player) MonsterState
  +label() String
}
class IdleState
class HuntingState
class EnragedState
class FleeingState
class DeadState
MonsterState <|.. IdleState
MonsterState <|.. HuntingState
MonsterState <|.. EnragedState
MonsterState <|.. FleeingState
MonsterState <|.. DeadState
Monster --> "1" MonsterState : current lifecycle state
MonsterState ..> MonsterState : returns next state
EnragedState ..> AggressiveStrategy : installs on entry
FleeingState ..> SkittishStrategy : installs on entry
Combat ..> MonsterState : checks and advances state

class GameState {
  <<interface>>
  +onEnter(GameContext) void
  +onExit(GameContext) void
  +availableCommands() List~String~
  +name() String
}
class ExploringState
class CombatState
class InventoryState
class GameOverState
GameState <|.. ExploringState
GameState <|.. CombatState
GameState <|.. InventoryState
GameState <|.. GameOverState
GameContext --> "1" GameState : current UI state
GameState ..> GameContext : lifecycle callbacks

%% ============================================================
%% PATTERN 3 — COMMAND + TEMPLATE METHOD + NULL OBJECT + MACRO
%% Commands package requests as objects, support undo/logging.
%% AbstractCommand fixes execution order; subclasses implement
%% doExecute(). MacroCommand composes commands recursively.
%% NoCommand is a safe no-op instead of null.
%% ============================================================
class Command {
  <<interface>>
  +execute() void
  +undo() void
  +getDescription() String
  +isUndoable() boolean
  +endsTurn() boolean
}
class AbstractCommand {
  <<abstract / Template Method>>
  #GameContext ctx
  #String args
  +execute() void
  #doExecute()* boolean
  +undo() void
}
class MoveCommand
class AttackCommand
class TakeCommand
class DropCommand
class UseItemCommand
class SimpleCommand
class MacroCommand {
  +List~Command~ children
  +execute() void
  +undo() void
}
class NoCommand {
  <<Null Object>>
  +execute() void
  +undo() void
}
class CommandParser {
  +parse(String, GameContext) Command
}
class CommandFactory {
  +create(String, GameContext) Command
}
class CommandHistory {
  -Deque~Command~ undoStack
  -List~String~ replayLog
  +push(Command) void
  +undoLast() boolean
}
class TurnSnapshot {
  +capture(Player, Room) TurnSnapshot
  +restore() void
}
Command <|.. AbstractCommand
AbstractCommand <|-- MoveCommand
AbstractCommand <|-- AttackCommand
AbstractCommand <|-- TakeCommand
AbstractCommand <|-- DropCommand
AbstractCommand <|-- UseItemCommand
Command <|.. SimpleCommand
Command <|.. MacroCommand
Command <|.. NoCommand
MacroCommand o--> "0..*" Command : children
CommandParser ..> CommandFactory : delegates creation
CommandParser ..> Command : returns
CommandFactory ..> Command : creates
CommandHistory o--> "0..*" Command : undo stack
AbstractCommand ..> TurnSnapshot : captures / restores
AbstractCommand --> GameContext : receiver/context
Main ..> CommandParser : parses input
Main ..> CommandHistory : records commands

%% ============================================================
%% PATTERN 4 — OBSERVER
%% EventBus is the subject/publisher. Listener implementations
%% subscribe and react to GameEvent without Combat knowing them.
%% ============================================================
class EventBus {
  <<Subject / Publisher>>
  +subscribe(GameEventListener) void
  +unsubscribe(GameEventListener) void
  +publish(GameEvent) void
}
class GameEventListener {
  <<interface / Observer>>
  +onEvent(GameEvent) void
}
class GameEvent {
  +EventType type
  +payload
}
class EventType {
  <<enum>>
}
class QuestTracker
class AchievementSystem
class CombatLog
class DangerMeter
EventBus o--> "0..*" GameEventListener : subscribers
GameEventListener <|.. QuestTracker
GameEventListener <|.. AchievementSystem
GameEventListener <|.. CombatLog
GameEventListener <|.. DangerMeter
EventBus ..> GameEvent : publishes
GameEvent --> EventType : categorized by
Combat --> EventBus : publishes combat events
QuestTracker ..> EventBus : may publish completion message
Main ..> EventBus : wires listeners

%% ============================================================
%% PATTERN 5 — ABSTRACT FACTORY + FACTORY METHOD
%% ThemeKit creates families of related themed products.
%% RoomPopulator defines room population variation; concrete
%% populators specialize the algorithm for room types.
%% MonsterFactory centralizes monster creation from definitions.
%% ============================================================
class ThemeKit {
  <<interface / Abstract Factory>>
  +themeName() String
  +createMonster(int) Monster
  +createBoss(int) Monster
  +createLoot(int) Item
  +createRoomFlavor() String
}
class CryptThemeKit
class ForgeThemeKit
class FrostThemeKit
class WinterfellThemeKit
ThemeKit <|.. CryptThemeKit
ThemeKit <|.. ForgeThemeKit
ThemeKit <|.. FrostThemeKit
ThemeKit <|.. WinterfellThemeKit
class ThemeRegistry {
  +forDepth(int) ThemeKit
}
class MonsterFactory {
  +create(String, int) Monster
  +idsForTheme(String) List~String~
}
class MonsterDef
class RoomPopulator {
  <<abstract / Factory Method>>
  #ThemeKit theme
  +populate(Room, int) void
}
class StandardRoomPopulator
class TreasureRoomPopulator
class BossRoomPopulator
RoomPopulator <|-- StandardRoomPopulator
RoomPopulator <|-- TreasureRoomPopulator
RoomPopulator <|-- BossRoomPopulator
ThemeRegistry --> MonsterFactory : configures theme kits
ThemeRegistry ..> ThemeKit : selects
ThemeKit ..> MonsterFactory : creates monsters through
MonsterFactory ..> MonsterDef : reads definitions
RoomPopulator --> ThemeKit : uses product family
StandardRoomPopulator ..> Room : populates
TreasureRoomPopulator ..> Room : populates
BossRoomPopulator ..> Room : populates
GameWorld --> ThemeRegistry : selects theme
GameWorld ..> RoomPopulator : chooses populator
GameWorld ..> ThemeKit : asks for room flavor

%% ============================================================
%% PATTERN 6 — SINGLETON
%% Private constructors + static getInstance() centralize
%% configuration and seeded randomness. Global state is a tradeoff.
%% ============================================================
class GameConfig {
  <<Singleton>>
  -static GameConfig instance
  -GameConfig()
  +getInstance() GameConfig$
  +getInt(String) int
  +getDouble(String) double
}
class RandomSource {
  <<Singleton>>
  -static RandomSource instance
  -RandomSource()
  +getInstance() RandomSource$
  +nextInt(int) int
  +nextDouble() double
  +reseed(long) void
}
RandomSource ..> GameConfig : gets seed from
GameWorld ..> GameConfig : reads generation settings
MonsterFactory ..> GameConfig : reads config
Combat ..> GameConfig : reads rest settings
SkittishStrategy ..> GameConfig : reads flee threshold

%% ============================================================
%% CORE OOP — inheritance, encapsulation, composition, associations
%% ============================================================
class Entity {
  <<abstract>>
  #String name
  #int hp
  #int maxHp
  #int attackPower
  #int defense
  +isAlive() boolean
  +takeDamage(int) void
  +heal(int) void
  +describe()* String
}
class Player {
  -int gold
  -int xp
  -List~Item~ inventory
}
class Monster {
  -String species
  -int xpReward
  -CombatStrategy strategy
  -MonsterState stateName
  +hpFraction() double
  +setStrategy(CombatStrategy) void
  +setState(MonsterState) void
}
Entity <|-- Player : inheritance
Entity <|-- Monster : inheritance
class GameWorld {
  -Player player
  -List~DungeonLevel~ levels
  +generate() void
  +startingRoom() Room
}
class DungeonLevel {
  -int depth
  -String themeName
  -List~Room~ rooms
}
class Room {
  -String id
  -String flavor
  -List~Monster~ monsters
  -List~Item~ floorItems
  -Chest chest
  -Map~String,Room~ exits
}
class Chest {
  -String name
  -List~Item~ contents
}
GameWorld --> "1" Player
GameWorld *-- "1..*" DungeonLevel : owns
DungeonLevel *-- "1..*" Room : contains
Room o--> "0..*" Monster : monsters
Room o--> "0..*" Item : floor loot
Room --> "0..1" Chest : treasure chest
Room --> "0..*" Room : exits / navigation
Combat ..> Player
Combat ..> Monster
Combat ..> Room

%% ============================================================
%% ITEM ABSTRACTION — polymorphic inventory and loot products
%% Decorator and Composite are documented as future exercises
%% in the source, not implemented in this supplied code.
%% ============================================================
class Item {
  <<interface>>
  +getName() String
  +getWeight() double
  +getValue() int
  +describe() String
}
class Weapon
class Armor
class Potion
class Treasure
class Hourglass
Item <|.. Weapon
Item <|.. Armor
Item <|.. Potion
Item <|.. Treasure
Item <|.. Hourglass
Player o--> "0..*" Item : inventory
Chest o--> "0..*" Item : contents

%% ============================================================
%% TOP-LEVEL ORCHESTRATION
%% ============================================================
class Main {
  +main(String[]) void$
  -gameLoop(CommandParser, GameContext, CommandHistory) void$
  -runScript(CommandParser, GameContext, CommandHistory, List) void$
}
class GameContext {
  -GameWorld world
  -Player player
  -EventBus bus
  -Combat combat
  -CommandHistory history
  -GameState state
  +transitionTo(GameState) void
}
Main ..> GameWorld : constructs
Main ..> GameContext : wires dependencies
GameContext --> GameWorld
GameContext --> Player
GameContext --> Combat
GameContext --> EventBus
GameContext --> CommandHistory

%% ============================================================
%% VISUAL KEY — pattern families are highlighted by color.
%% Inheritance: hollow triangle; composition: filled diamond;
%% aggregation: hollow diamond; dependency: dashed arrow.
%% ============================================================
classDef strategy fill:#d8ecff,stroke:#1769aa,color:#102a43,stroke-width:2px
classDef state fill:#e8ddff,stroke:#6b3fa0,color:#24113f,stroke-width:2px
classDef command fill:#d9f5e5,stroke:#16804a,color:#103b28,stroke-width:2px
classDef observer fill:#fff0cc,stroke:#a66300,color:#4a2b00,stroke-width:2px
classDef factory fill:#ffe0e0,stroke:#b42332,color:#4a1118,stroke-width:2px
classDef singleton fill:#fce0f2,stroke:#a61e72,color:#4a1235,stroke-width:2px
classDef core fill:#e9eef2,stroke:#465560,color:#17232c
classDef item fill:#e0f4f1,stroke:#087e72,color:#073d38